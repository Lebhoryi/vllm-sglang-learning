        <mxCell id="13" value="launch_core_engines(vllm_config, executor_class, addresses)&#10;父进程开 handshake ROUTER，等各 core 回连&#10;DP &gt; 1 时另起 DP Coordinator 进程" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FAE2D4;strokeColor=#B89E8A;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
