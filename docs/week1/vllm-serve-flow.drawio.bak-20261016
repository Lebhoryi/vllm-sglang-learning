          <mxGeometry x="60" y="956" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="wait_for_completion_or_failure()&#10;父进程只监督：任一子进程挂 → 全部收摊" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1174" width="360" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="EngineCoreProc.run_engine_core（子进程）&#10;set_process_title(EngineCore) · 每 DP rank 一个&#10;1 core = 1 个独立进程" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="506" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="17" value="EngineCore.__init__&#10;executor_class(vllm_config) · 权重加载进显存&#10;worker 跑在哪看 world_size：&#10;=1 UniProcExecutor → 同进程；&gt;1 MultiprocExecutor → spawn N 个 Worker" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="622" width="360" height="124" as="geometry"/>
        </mxCell>
        <mxCell id="18" value="Scheduler(...) + StructuredOutputManager&#10;KV cache 规格 / block size / 并发上限定型" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="762" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="_initialize_kv_caches()&#10;determine_available_memory() → kv_cache_config&#10;initialize_from_config()：切分 paged KV 显存" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="864" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="20" value="compile_or_warm_up_model()&#10;torch.compile + CUDA Graph 捕获 + 预热&#10;（最慢一步，分钟级）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="980" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="ZMQ 握手：core DEALER → 前端 ROUTER&#10;报自己的 input/output socket 地址" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="1096" width="360" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="busy loop 起转（阶段 1 到此结束）&#10;空转等 EngineCoreRequest&#10;收到就 schedule → execute → collect" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F4E1F;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="1198" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="API server 子进程&#10;run_server_worker → build_async_engine_client" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1072" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="24" value="AsyncLLM.from_vllm_config(...)&#10;自建 renderer / InputProcessor / OutputProcessor&#10;EngineCoreClient.make_async_mp_client() → AsyncMPClient" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1174" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="25" value="build_and_serve()&#10;build_app() + init_app_state()&#10;app.state.engine_client = AsyncLLM（静态类型 EngineClient）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1290" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="26" value="serve_http() → uvicorn 监听 0.0.0.0:8001&#10;日志：Starting vLLM server on ...&#10;✅ 服务就绪，可以发请求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F4E1F;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1406" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="27" value="另开 shell B · 作为客户端&#10;scripts/test_chat.sh 8001 $MODEL_08B 「who are you」" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1350" y="1630" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="28" value="curl POST /v1/chat/completions&#10;body: model + messages[user] = who are you&#10;（默认非流式，max_tokens=128）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1350" y="1732" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="29" value="uvicorn 收包 → FastAPI 路由&#10;create_chat_completion() 解析 body&#10;→ ChatCompletionRequest；handler = chat(raw_request)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1732" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="30" value="OpenAIServingChat.create_chat_completion()&#10;套 chat template → prompt 文本&#10;拼 SamplingParams" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1848" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="engine_client.generate(prompt, params, request_id)&#10;静态类型 = EngineClient，运行时对象 = AsyncLLM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1950" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="AsyncLLM.generate() 第 1 步：&#10;input_processor.process_inputs()&#10;tokenize「who are you」→ EngineCoreRequest(token_ids)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2052" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="第 2 步：output_processor.add_request()&#10;为本请求建队列（AsyncStream），准备收 token&#10;第 3 步：await async_mp_client.add_request_async(req)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2168" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="core DEALER 收到 EngineCoreRequest&#10;Scheduler.schedule() → 入批（chunked prefill）&#10;KVCacheManager 分配 KV block" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="2168" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="35" value="Executor → GPU worker&#10;模型前向 → logits → sampler 采样&#10;拿到第 1 个 token（MRV1 / MRV2 runner）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="2284" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="36" value="EngineCoreOutputs（新 token + 状态）&#10;msgpack 编码 → core PUSH 发出" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="2400" width="360" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="37" value="循环：每步再 schedule → execute → push&#10;直到 EOS / max_tokens → finish_reason=stop" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="2516" width="360" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="38" value="output_handler 后台 task&#10;await get_output_async()（前端 PULL 收）&#10;→ OutputProcessor.process_outputs() → detokenize → RequestOutput" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2400" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="39" value="AsyncLLM.generate() yield RequestOutput&#10;serving 层拼 SSE chunk（chat.completion.chunk）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2516" width="360" height="90" as="geometry"/>
        </mxCell>
