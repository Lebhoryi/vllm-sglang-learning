<mxfile host="app.diagrams.net" type="device">
  <diagram name="vllm serve 全流程" id="vllm-serve-flow">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="3060" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="3" value="vLLM serve 全流程：进程边界 + 从启动到一次请求（who are you）" style="text;html=1;fontSize=34;fontStyle=1;fontColor=#1F4E79;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="12" width="1500" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="① vllm serve 父进程 ×1&#10;只编排，不装模型" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FAE2D4;strokeColor=#B89E8A;fontColor=#333333;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="66" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="② EngineCore 进程 ×DP&#10;每 DP rank 一个；跑 scheduler" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="490" y="66" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="③ API server 进程 ×A&#10;默认 = DP（--api-server-count 可改）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="66" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="④ 客户端（另开 shell，非 vLLM 进程）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#333333;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1350" y="66" width="360" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="阶段 1 · vllm serve 启动：拉进程 + 装模型 + 就绪" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=none;strokeColor=#B3B3B3;dashed=1;dashPattern=10 8;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#666666;align=left;spacingLeft=16;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="124" width="1740" height="1422" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="阶段 2 · 客户端请求：who are you → 首 token → 流式返回" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=none;strokeColor=#B3B3B3;dashed=1;dashPattern=10 8;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#666666;align=left;spacingLeft=16;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="1566" width="1740" height="1240" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="起服务 · shell A&#10;scripts/start_vllm_qwen35_08b.sh&#10;→ vllm serve &lt;model&gt; --port 8001" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FAE2D4;strokeColor=#B89E8A;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="186" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="CLI 入口 · entrypoints/cli/serve.py&#10;ServeSubcommand.cmd → 解析参数&#10;AsyncEngineArgs → create_engine_config()" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FAE2D4;strokeColor=#B89E8A;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="288" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="vllm_config = VllmConfig（配置定型）&#10;model / parallel / scheduler / cache&#10;get_engine_zmq_addresses() 预分配 inputs+outputs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FAE2D4;strokeColor=#B89E8A;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="launch_core_engines(vllm_config, executor_class, addresses)&#10;父进程开 handshake ROUTER，等各 core 回连&#10;DP &gt; 1 时另起 DP Coordinator 进程（+1）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FAE2D4;strokeColor=#B89E8A;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="506" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="APIServerProcessManager&#10;spawn A 个 API server 子进程&#10;默认 A = DP size，可 --api-server-count" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FAE2D4;strokeColor=#B89E8A;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="956" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="wait_for_completion_or_failure()&#10;父进程只监督：任一子进程挂 → 全部收摊" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1174" width="360" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="进程账本（官方 §V1 Process Architecture）&#10;① 父进程 1（编排，不装模型）&#10;② EngineCore 进程 = DP&#10;③ API server 进程 = A（默认 DP）&#10;④ GPU worker 进程 = DP × PP × TP（每卡一个）&#10;⑤ DP coordinator 进程 = 1（仅 DP &gt; 1）&#10;总数 = A + DP + N（DP &gt; 1 再 +1）&#10;本图例子：单卡单 DP → 3 个进程&#10;（父 + EngineCore + API server）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="1290" width="360" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="17" value="EngineCoreProc.run_engine_core（子进程）&#10;set_process_title(EngineCore) · 每 DP rank 一个&#10;1 core = 1 个独立进程" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="506" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="18" value="EngineCore.__init__&#10;executor_class(vllm_config) · 权重加载进显存&#10;worker 跑在哪，看 world_size（见下）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="622" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="GPU worker 进程 ×N = DP × PP × TP&#10;（每卡一个；MultiprocExecutor spawn）&#10;world_size = 1 时 worker 与 core 同进程（UniProcExecutor）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="742" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="20" value="Scheduler(...) + StructuredOutputManager&#10;KV cache 规格 / block size / 并发上限定型" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="862" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="_initialize_kv_caches()&#10;determine_available_memory() → kv_cache_config&#10;initialize_from_config()：切分 paged KV 显存" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="964" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="compile_or_warm_up_model()&#10;torch.compile + CUDA Graph 捕获 + 预热&#10;（最慢一步，分钟级）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="1080" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="ZMQ 握手：core DEALER → 前端 ROUTER&#10;报自己的 input/output socket 地址" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="1196" width="360" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="24" value="busy loop 起转（阶段 1 到此结束）&#10;空转等 EngineCoreRequest&#10;收到就 schedule → execute → collect" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F4E1F;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="1298" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="25" value="API server 子进程&#10;run_server_worker → build_async_engine_client" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1072" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="26" value="AsyncLLM.from_vllm_config(...)&#10;自建 renderer / InputProcessor / OutputProcessor&#10;EngineCoreClient.make_async_mp_client() → AsyncMPClient" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1174" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="27" value="build_and_serve()&#10;build_app() + init_app_state()&#10;app.state.engine_client = AsyncLLM（静态类型 EngineClient）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1290" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="28" value="serve_http() → uvicorn 监听 0.0.0.0:8001&#10;日志：Starting vLLM server on ...&#10;✅ 服务就绪，可以发请求" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F4E1F;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1406" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="29" value="另开 shell B · 作为客户端&#10;scripts/test_chat.sh 8001 $MODEL_08B 「who are you」" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1350" y="1630" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="30" value="curl POST /v1/chat/completions&#10;body: model + messages[user] = who are you&#10;（默认非流式，max_tokens=128）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1350" y="1732" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="uvicorn 收包 → FastAPI 路由&#10;create_chat_completion() 解析 body&#10;→ ChatCompletionRequest；handler = chat(raw_request)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1732" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="OpenAIServingChat.create_chat_completion()&#10;套 chat template → prompt 文本&#10;拼 SamplingParams" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1848" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="engine_client.generate(prompt, params, request_id)&#10;静态类型 = EngineClient，运行时对象 = AsyncLLM" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1950" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="AsyncLLM.generate() 第 1 步：&#10;input_processor.process_inputs()&#10;tokenize「who are you」→ EngineCoreRequest(token_ids)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2052" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="35" value="第 2 步：output_processor.add_request()&#10;为本请求建队列（AsyncStream），准备收 token&#10;第 3 步：await async_mp_client.add_request_async(req)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2168" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="36" value="core DEALER 收到 EngineCoreRequest&#10;Scheduler.schedule() → 入批（chunked prefill）&#10;KVCacheManager 分配 KV block" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="2168" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="37" value="Executor → GPU worker 进程 ×N&#10;模型前向 → logits → sampler 采样&#10;拿到第 1 个 token（MRV1 / MRV2 runner）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="2284" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="38" value="EngineCoreOutputs（新 token + 状态）&#10;msgpack 编码 → core PUSH 发出" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="2400" width="360" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="39" value="循环：每步再 schedule → execute → push&#10;直到 EOS / max_tokens → finish_reason=stop" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="2516" width="360" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="40" value="output_handler 后台 task&#10;await get_output_async()（前端 PULL 收）&#10;→ OutputProcessor.process_outputs() → detokenize → RequestOutput" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2400" width="360" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="AsyncLLM.generate() yield RequestOutput&#10;serving 层拼 SSE chunk（chat.completion.chunk）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="2516" width="360" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="uvicorn 写回 text/event-stream&#10;curl 累积 delta.content 直到 [DONE]" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#333333;fontSize=15;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
