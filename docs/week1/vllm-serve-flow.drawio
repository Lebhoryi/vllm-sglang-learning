        </mxCell>
        <mxCell id="43" value="终端打印 JSON（test_chat.sh 用 json.tool 美化）&#10;content = 模型对 who are you 的回答" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1F4E1F;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
