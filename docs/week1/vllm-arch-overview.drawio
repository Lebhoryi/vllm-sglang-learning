        <mxCell id="43" edge="1" parent="1" source="23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=classic;dashed=1;dashPattern=8 6;fontSize=16;fontColor=#555555;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="28" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="44" edge="1" parent="1" source="28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=classic;dashed=1;dashPattern=8 6;fontSize=16;fontColor=#555555;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="31" value="batch 前向">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="45" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=3;fillColor=#F2F7FF;strokeColor=#6C8EBF;fontSize=22;fontStyle=1;fontColor=#1F4E79;verticalAlign=top;spacingTop=10;" value="V1 进程边界（官方 §V1 Process Architecture）" vertex="1">
          <mxGeometry height="1090" width="500" x="1790" y="90" as="geometry" />
        </mxCell>
        <mxCell id="46" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#333333;fontSize=18;fontSize=16;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="① API Server 进程 ×A&#xa;默认 A = DP（internal LB）；external / multi-port / rust frontend 时为 1；hybrid LB 用 local DP size&#xa;入口层 + 引擎门面都跑在这里：&#xa;收 HTTP、tokenize、多模态加载、&#xa;OutputProcessor / Detokenizer 流式返回&#xa;每个 API server 连所有 engine core（ZMQ 多对多）" vertex="1">
          <mxGeometry height="300" width="456" x="1812" y="140" as="geometry" />
        </mxCell>
        <mxCell id="47" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#EBDFF2;strokeColor=#9673A6;fontColor=#333333;fontSize=18;fontSize=16;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="② Engine core 进程 ×DP&#xa;每 DP rank 一个；调度与 KV 全在这里：&#xa;scheduler + KV cache + busy loop&#xa;executor 反过来在它进程内 spawn GPU worker" vertex="1">
          <mxGeometry height="240" width="456" x="1812" y="470" as="geometry" />
        </mxCell>
        <mxCell id="48" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#333333;fontSize=18;fontSize=16;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="③ GPU worker 进程 ×N = DP × PP × TP&#xa;每卡一个：加载权重、跑 forward、管显存&#xa;只跟「拥有它的那个 engine core」通信&#xa;world_size = 1 时退化：worker 不单独起进程，&#xa;与 engine core 同进程（UniProcExecutor）" vertex="1">
          <mxGeometry height="330" width="456" x="1812" y="740" as="geometry" />
        </mxCell>
        <mxCell id="49" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#333333;fontSize=18;fontSize=16;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" value="④ DP Coordinator 进程 ×1（仅 DP &gt; 1）" vertex="1">
          <mxGeometry height="60" width="456" x="1812" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="50" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=18;fontSize=16;align=left;spacingLeft=12;" value="进程数 = A + DP + N（DP &gt; 1 再 +1）&#xa;· vllm serve -tp=4 → 1 + 1 + 4 = 6 个进程&#xa;· vllm serve -tp=2 -dp=4 → 4 + 4 + 8 + 1 = 17 个进程&#xa;两个例子画在第 2 页「V1 进程拓扑」" vertex="1">
          <mxGeometry height="170" width="500" x="1790" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="51" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=18;align=left;spacingLeft=14;" value="读图：① 请求下行 HTTP → AsyncLLM → EngineCore → Scheduler / KVCacheManager → Worker → Model 前向；② 结果上行 采样 → OutputProcessor → Detokenizer → 流式 SSE&#xa;虚线 = 跨层数据传递（paged KV blocks、batch 前向）；⭐ = 阶段一/二走读主线；右侧列 = 官方 V1 进程边界（进程数 = A + DP + N）&#xa;版本锚点：share/2026Q4/vllm  main 00b7847c80（≈ v0.30.1rc0-60，2026-09-24 实测行号）；引擎主体在 vllm/v1/，没有顶层 vllm/core/；进程口径见官方 docs/design/arch_overview.md §V1 Process Architecture" vertex="1">
          <mxGeometry height="84" width="1720" x="40" y="1420" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="V1 进程拓扑（TP=4｜TP=2+DP=4）" id="v1-process-topology">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2100" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
