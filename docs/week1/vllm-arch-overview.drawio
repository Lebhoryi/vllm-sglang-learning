        <mxCell id="116" value="4 + 4 + 8 + 1 = 17 个进程（8 GPU = DP 4 rank × 每 rank TP 2 卡）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=18;fontSize=16;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="1100" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="117" value="ZMQ 多对多：每个 API server 连所有 4 个 engine core（面板内 16 条细线）" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=18;fontSize=16;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="1150" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="118" value="进程数公式：A + DP + N（DP &gt; 1 再 +1）。A = API server 数（internal LB 默认 = DP；external / multi-port / rust frontend = 1；hybrid LB = local DP）&#xa;N = 每卡一个 worker 进程 = DP × PP × TP；GPU worker 只在 world_size &gt; 1 时才独立起进程，单卡（world_size = 1）与 engine core 同进程&#xa;进程间怎么说话：客户端 ↔ API server 走 HTTP；API server ↔ engine core 走 ZMQ（多对多，请求 ROUTER→DEALER、结果 PUSH→PULL）；engine core ↔ GPU worker 走 MultiprocExecutor 的 IPC，张量走 NCCL / 共享内存，不走 ZMQ&#xa;官方附图对应：v1_process_architecture_tp4.png = 面板 ①；v1_process_architecture_tp2_dp4.png = 面板 ②。代码锚点：entrypoints/cli/serve.py:105（A 默认值）、v1/engine/utils.py:1100（coordinator 条件启动）、v1/executor/multiproc_executor.py:111（每卡一个 worker 进程）" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#FFFBE6;strokeColor=#CFC286;fontColor=#5C4B00;fontSize=18;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="1250" width="2020" height="150" as="geometry" />
        </mxCell>
      </root>
